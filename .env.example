# Application Configuration
PORT=3000
API_PORT=3000
NODE_ENV=production

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nightly_digest
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/nightly_digest

# Redis Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Scheduler Configuration
CRON_SCHEDULE=0 0 * * *
